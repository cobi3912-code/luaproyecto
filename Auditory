--[[
====================================================================
 PRO-ANALYSIS v2.1 — BLACK-BOX SERVER AUDIT LOGGER
--------------------------------------------------------------------
 Tipo: Script de servidor Roblox (Luau), NO LocalScript.
 Instalacion: ServerScriptService en una copia/servidor de auditoria.
 Cuenta auditada: jugador normal, filtrado por UserId.
 Exportacion: lotes JSON en Server Output / Developer Console.

 ALCANCE REAL
 - Observa argumentos que realmente llegan al servidor mediante
   RemoteEvent y UnreliableRemoteEvent.
 - Opcionalmente envuelve OnServerInvoke para capturar argumentos y
   respuestas de RemoteFunction. Esta opcion es INTRUSIVA y por eso
   viene desactivada.
 - Crea ServerStorage.__PRO_ANALYSIS_MARK para que los handlers del
   propietario puedan registrar ACCEPTED / REJECTED / DETECTED.
 - No otorga permisos al auditor, no dispara remotos, no cambia los
   argumentos recibidos y no intenta evadir anticheats.

 LIMITACIONES IMPORTANTES
 - Esto no observa llamadas que nunca llegan al servidor.
 - Un observador OnServerEvent adicional puede hacer que un RemoteEvent
   sin otros listeners deje de producir el aviso de evento descartado.
 - RemoteFunction requiere reemplazar temporalmente OnServerInvoke; la
   envoltura puede alterar identidad de callback/stack y añade overhead.
 - Workspace con StreamingEnabled no garantiza que un objeto estuviera
   replicado al cliente en cada instante; el scope se marca como probable.
 - Solo captura el UserId configurado. No actives captura global por error.
====================================================================
]]

-- ============================== CONFIG =============================
local CONFIG = {
    AuditId = "REPLACE-WITH-SIGNED-ENGAGEMENT-ID",

    -- REEMPLAZA 123456789 por el UserId numérico de la cuenta auditora.
    -- Por seguridad, si no hay un ID válido, el script se detiene.
    TargetUserIds = {
        [123456789] = true,
    },

    CaptureRemoteEvents = true,
    CaptureUnreliableRemoteEvents = true,

    -- FALSO por defecto: envolver OnServerInvoke cambia el callback.
    -- Actívalo solo en una copia de pruebas y tras verificar el juego.
    CaptureRemoteFunctions = false,
    RemoteFunctionRescanSeconds = 2,

    -- Serialización limitada para evitar congelaciones o uso excesivo.
    MaxDepth = 6,
    MaxTableEntries = 24,
    MaxNodesPerEvent = 120,
    MaxArguments = 32,
    MaxStringLength = 1024,
    MaxEventBytes = 8 * 1024,

    -- Cola y salida.
    QueueCapacity = 1200,
    BatchSize = 6,
    FlushInterval = 0.5,
    MaxRecordsPerSecond = 12,

    -- Privacidad. Los valores bajo claves sensibles se marcan como redacted.
    RedactSensitiveKeys = true,
    IncludePlayerName = false,

    -- Identificador de cada lote en Server Output.
    OutputPrefix = "[[PRO_ANALYSIS_V21]] ",

    -- Escanear estos contenedores replicados al cliente.
    WatchReplicatedStorage = true,
    WatchReplicatedFirst = true,
    WatchWorkspace = true,
}

-- ============================== SERVICES ===========================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

-- ============================== VALIDATION =========================
local targetConfigured = false
for userId, enabled in pairs(CONFIG.TargetUserIds) do
    if type(userId) == "number" and userId > 0 and enabled == true then
        targetConfigured = true
        break
    end
end

if not targetConfigured then
    warn("[PRO-ANALYSIS] Sin TargetUserIds válido. Auditoría no iniciada.")
    return
end

if CONFIG.AuditId == "REPLACE-WITH-SIGNED-ENGAGEMENT-ID" then
    warn("[PRO-ANALYSIS] Configura AuditId con el identificador del acuerdo.")
    return
end

local function isTargetPlayer(player)
    return typeof(player) == "Instance"
        and player:IsA("Player")
        and CONFIG.TargetUserIds[player.UserId] == true
end

-- Evita dos instalaciones accidentales del mismo Script.
local stateMarker = ServerStorage:FindFirstChild("__PRO_ANALYSIS_V21_ACTIVE")
if stateMarker then
    warn("[PRO-ANALYSIS] Ya existe una instancia activa. Segunda instalación cancelada.")
    return
end

stateMarker = Instance.new("BoolValue")
stateMarker.Name = "__PRO_ANALYSIS_V21_ACTIVE"
stateMarker.Value = true
stateMarker.Parent = ServerStorage

-- ============================== SESSION ============================
local sessionId = HttpService:GenerateGUID(false)
local startedAtUtc = DateTime.now():ToIsoDate()
local sequence = 0
local batchSequence = 0

local stats = {
    eventsSeen = 0,
    functionsSeen = 0,
    marksSeen = 0,
    dropped = 0,
    rateLimited = 0,
    queueOverflow = 0,
    serializationErrors = 0,
}

-- ============================== SAFE HELPERS =======================
local function safeToString(value)
    local ok, result = pcall(tostring, value)
    return ok and result or "[tostring-error]"
end

local function safeRead(object, property)
    local ok, value = pcall(function()
        return object[property]
    end)
    return ok and value or nil
end

local function getKind(value)
    local ok, result = pcall(typeof, value)
    if ok and type(result) == "string" then
        return result
    end
    return type(value)
end

local function isFiniteNumber(value)
    return value == value and value ~= math.huge and value ~= -math.huge
end

local function encodeNumber(value)
    if not isFiniteNumber(value) then
        return safeToString(value)
    end
    return value
end

local function truncateString(value, limit)
    if #value <= limit then
        return value, false
    end
    return string.sub(value, 1, limit) .. "...[TRUNCATED]", true
end

local REDACT_PARTS = {
    "password", "passwd", "token", "secret", "cookie",
    "authorization", "apikey", "api_key", "sessionkey",
}

local function isSensitiveKey(key)
    if not CONFIG.RedactSensitiveKeys or type(key) ~= "string" then
        return false
    end
    local lowered = string.lower(key)
    for _, fragment in ipairs(REDACT_PARTS) do
        if string.find(lowered, fragment, 1, true) then
            return true
        end
    end
    return false
end

local function keySortToken(key)
    local kind = type(key)
    if kind == "string" then
        return "1:string:" .. key
    elseif kind == "number" then
        return "2:number:" .. string.format("%.17g", key)
    elseif kind == "boolean" then
        return "3:boolean:" .. tostring(key)
    end
    return "9:" .. getKind(key) .. ":" .. safeToString(key)
end

-- ============================== SERIALIZER =========================
-- JSON-safe representation. Tables are encoded as ordered key/value
-- entries, not JSON objects, so mixed key types are not silently lost.
local serializeValue

serializeValue = function(value, depth, visited, budget)
    depth = depth or 0
    visited = visited or {}
    budget = budget or { remaining = CONFIG.MaxNodesPerEvent }

    if budget.remaining <= 0 then
        return { __type = "truncated", reason = "node-budget" }
    end
    budget.remaining = budget.remaining - 1

    if value == nil then
        return { __type = "nil" }
    end

    local basicType = type(value)
    local kind = getKind(value)

    if basicType == "string" then
        local text, wasTruncated = truncateString(value, CONFIG.MaxStringLength)
        if wasTruncated then
            return {
                __type = "string",
                value = text,
                originalLength = #value,
                truncated = true,
            }
        end
        return value
    elseif basicType == "boolean" then
        return value
    elseif basicType == "number" then
        return encodeNumber(value)
    elseif basicType == "function" or basicType == "thread" then
        return { __type = basicType }
    end

    if kind == "Instance" then
        local fullName = "[unavailable]"
        pcall(function()
            fullName = value:GetFullName()
        end)
        return {
            __type = "Instance",
            className = safeToString(safeRead(value, "ClassName") or "unknown"),
            name = safeToString(safeRead(value, "Name") or "unknown"),
            path = safeToString(fullName),
        }
    elseif kind == "EnumItem" then
        local enumType = safeRead(value, "EnumType")
        return {
            __type = "EnumItem",
            enumType = enumType and safeToString(enumType) or "unknown",
            name = safeToString(safeRead(value, "Name") or value),
            value = safeRead(value, "Value"),
        }
    elseif kind == "Vector3" then
        return { __type = kind, x = encodeNumber(value.X), y = encodeNumber(value.Y), z = encodeNumber(value.Z) }
    elseif kind == "Vector2" then
        return { __type = kind, x = encodeNumber(value.X), y = encodeNumber(value.Y) }
    elseif kind == "Color3" then
        return { __type = kind, r = encodeNumber(value.R), g = encodeNumber(value.G), b = encodeNumber(value.B) }
    elseif kind == "CFrame" then
        local components = table.pack(value:GetComponents())
        local output = {}
        for index = 1, components.n do
            output[index] = encodeNumber(components[index])
        end
        return { __type = kind, components = output }
    elseif kind == "UDim" then
        return { __type = kind, scale = encodeNumber(value.Scale), offset = encodeNumber(value.Offset) }
    elseif kind == "UDim2" then
        return {
            __type = kind,
            x = { scale = encodeNumber(value.X.Scale), offset = encodeNumber(value.X.Offset) },
            y = { scale = encodeNumber(value.Y.Scale), offset = encodeNumber(value.Y.Offset) },
        }
    elseif kind == "NumberRange" then
        return { __type = kind, min = encodeNumber(value.Min), max = encodeNumber(value.Max) }
    elseif kind == "BrickColor" then
        return { __type = kind, name = safeRead(value, "Name"), number = safeRead(value, "Number") }
    elseif kind == "DateTime" then
        return {
            __type = kind,
            unixTimestamp = safeRead(value, "UnixTimestamp"),
            unixTimestampMillis = safeRead(value, "UnixTimestampMillis"),
        }
    elseif kind == "Ray" then
        return {
            __type = kind,
            origin = serializeValue(value.Origin, depth + 1, visited, budget),
            direction = serializeValue(value.Direction, depth + 1, visited, budget),
        }
    elseif kind == "buffer" then
        local length = "unknown"
        if type(buffer) == "table" and type(buffer.len) == "function" then
            local ok, result = pcall(buffer.len, value)
            if ok then length = result end
        end
        return { __type = "buffer", length = length, contents = "omitted" }
    end

    if basicType == "table" then
        if depth >= CONFIG.MaxDepth then
            return { __type = "table", truncated = true, reason = "max-depth" }
        end
        if visited[value] then
            return { __type = "reference", value = "cycle" }
        end

        visited[value] = true

        local keys = {}
        local originalCount = 0
        local countIsLowerBound = false
        for key in pairs(value) do
            if originalCount >= CONFIG.MaxTableEntries then
                countIsLowerBound = true
                break
            end
            originalCount = originalCount + 1
            keys[#keys + 1] = { key = key, sort = keySortToken(key) }
        end

        table.sort(keys, function(left, right)
            return left.sort < right.sort
        end)

        local entries = table.create(#keys)
        for index, item in ipairs(keys) do
            local key = item.key
            local serializedKey = serializeValue(key, depth + 1, visited, budget)
            local serializedEntryValue

            if isSensitiveKey(key) then
                serializedEntryValue = { __type = "redacted", reason = "sensitive-key" }
            else
                serializedEntryValue = serializeValue(value[key], depth + 1, visited, budget)
            end

            entries[index] = {
                key = serializedKey,
                value = serializedEntryValue,
            }
        end

        visited[value] = nil

        return {
            __type = "table",
            entries = entries,
            originalEntryCountLowerBound = countIsLowerBound and (originalCount + 1) or originalCount,
            countIsLowerBound = countIsLowerBound,
            capturedEntryCount = #entries,
            truncated = countIsLowerBound,
        }
    end

    local printable, wasTruncated = truncateString(safeToString(value), CONFIG.MaxStringLength)
    return { __type = kind, value = printable, truncated = wasTruncated }
end

local function serializePackedArguments(packed)
    local count = tonumber(packed.n) or 0
    local capturedCount = math.min(count, CONFIG.MaxArguments)
    local items = table.create(capturedCount)
    local budget = { remaining = CONFIG.MaxNodesPerEvent }

    for index = 1, capturedCount do
        items[index] = {
            index = index,
            value = serializeValue(packed[index], 0, {}, budget),
        }
    end

    return {
        count = count,
        capturedCount = capturedCount,
        truncated = count > capturedCount,
        items = items,
    }
end

-- ============================== REMOTE METADATA ====================
local function getRemoteClass(instance)
    local ok, className = pcall(function()
        return instance.ClassName
    end)
    return ok and className or nil
end

local function getRemotePath(instance)
    local path = "[unavailable]"
    pcall(function()
        path = instance:GetFullName()
    end)
    return safeToString(path)
end

local function getClientScope(remote, player)
    local function isDescendantOf(instance, ancestor)
        if not ancestor then return false end
        local ok, result = pcall(function()
            return instance:IsDescendantOf(ancestor)
        end)
        return ok and result
    end

    if isDescendantOf(remote, ReplicatedStorage) then
        return "ReplicatedStorage"
    elseif isDescendantOf(remote, ReplicatedFirst) then
        return "ReplicatedFirst"
    elseif player and player.Character and isDescendantOf(remote, player.Character) then
        return "Player.Character"
    elseif player and isDescendantOf(remote, player) then
        return "Player subtree (for example PlayerGui/Backpack)"
    else
        for _, candidate in ipairs(Players:GetPlayers()) do
            if isTargetPlayer(candidate) then
                if candidate.Character and isDescendantOf(remote, candidate.Character) then
                    return "Player.Character"
                elseif isDescendantOf(remote, candidate) then
                    return "Player subtree (for example PlayerGui/Backpack)"
                end
            end
        end
    end

    if isDescendantOf(remote, Workspace) then
        return "Workspace (StreamingEnabled may make availability conditional)"
    end

    return "not-in-known-replicated-container-at-capture"
end

local function makeRemoteInfo(remote, player)
    return {
        className = getRemoteClass(remote) or "unknown",
        name = safeToString(safeRead(remote, "Name") or "unknown"),
        path = getRemotePath(remote),
        clientScope = getClientScope(remote, player),
    }
end

-- ============================== QUEUE / OUTPUT =====================
local queue = table.create(CONFIG.QueueCapacity)
local queueHead = 1
local queueTail = 1
local queueCount = 0
local droppedSinceFlush = 0

local function enqueue(record)
    if queueCount >= CONFIG.QueueCapacity then
        stats.dropped = stats.dropped + 1
        stats.queueOverflow = stats.queueOverflow + 1
        droppedSinceFlush = droppedSinceFlush + 1
        return false
    end

    queue[queueTail] = record
    queueTail = (queueTail % CONFIG.QueueCapacity) + 1
    queueCount = queueCount + 1
    return true
end

local function encodeRecord(record)
    local ok, json = pcall(function()
        return HttpService:JSONEncode(record)
    end)
    if ok and type(json) == "string" then
        return json
    end
    return nil
end

local function flushQueue()
    if queueCount == 0 then
        return
    end

    local records = table.create(math.min(queueCount, CONFIG.BatchSize))
    while queueCount > 0 and #records < CONFIG.BatchSize do
        local item = queue[queueHead]
        queue[queueHead] = nil
        queueHead = (queueHead % CONFIG.QueueCapacity) + 1
        queueCount = queueCount - 1
        if item then
            records[#records + 1] = item
        end
    end

    batchSequence = batchSequence + 1
    local envelope = {
        recordType = "PRO_ANALYSIS_BATCH",
        schema = "pro-analysis-blackbox-v2.1",
        auditId = CONFIG.AuditId,
        sessionId = sessionId,
        batchSequence = batchSequence,
        timestampUtc = DateTime.now():ToIsoDate(),
        placeId = game.PlaceId,
        universeId = game.GameId,
        placeVersion = game.PlaceVersion,
        jobId = game.JobId,
        recordsDroppedSincePreviousBatch = droppedSinceFlush,
        records = records,
    }

    local encoded = encodeRecord(envelope)
    if not encoded then
        stats.serializationErrors = stats.serializationErrors + 1
        stats.dropped = stats.dropped + #records
        droppedSinceFlush = droppedSinceFlush + #records
        warn("[PRO-ANALYSIS] No se pudo codificar un lote; registros descartados: " .. tostring(#records))
        return
    end

    droppedSinceFlush = 0
    print(CONFIG.OutputPrefix .. encoded)
end

local function emit(record)
    sequence = sequence + 1
    record.sequence = sequence
    record.auditId = CONFIG.AuditId
    record.sessionId = sessionId
    record.timestampUtc = DateTime.now():ToIsoDate()
    record.placeId = game.PlaceId
    record.universeId = game.GameId
    record.placeVersion = game.PlaceVersion
    record.jobId = game.JobId

    local encoded = encodeRecord(record)
    if not encoded then
        stats.serializationErrors = stats.serializationErrors + 1
        stats.dropped = stats.dropped + 1
        droppedSinceFlush = droppedSinceFlush + 1
        return false
    end

    if #encoded > CONFIG.MaxEventBytes then
        local originalBytes = #encoded
        local minimal = {
            recordType = record.recordType,
            sequence = record.sequence,
            auditId = record.auditId,
            sessionId = record.sessionId,
            timestampUtc = record.timestampUtc,
            placeId = record.placeId,
            universeId = record.universeId,
            placeVersion = record.placeVersion,
            jobId = record.jobId,
            payloadTruncated = true,
            originalSerializedBytes = originalBytes,
            note = "event-size-limit; full payload omitted",
        }
        if type(record.remote) == "table" then
            minimal.remote = {
                className = safeToString(record.remote.className or "unknown"),
                name = string.sub(safeToString(record.remote.name or "unknown"), 1, 120),
                path = string.sub(safeToString(record.remote.path or "unknown"), 1, 400),
            }
        end
        encoded = encodeRecord(minimal)
        if not encoded then
            stats.serializationErrors = stats.serializationErrors + 1
            stats.dropped = stats.dropped + 1
            droppedSinceFlush = droppedSinceFlush + 1
            return false
        end
        record = minimal
    end

    -- The record now contains only newly-created JSON-safe values; keeping it
    -- directly avoids a costly JSONEncode/JSONDecode round trip per event.
    return enqueue(record)
end

-- ============================== RATE CONTROL =======================
local rateWindowStart = os.clock()
local rateWindowCount = 0

local function allowRecord()
    local now = os.clock()
    if now - rateWindowStart >= 1 then
        rateWindowStart = now
        rateWindowCount = 0
    end

    if rateWindowCount >= CONFIG.MaxRecordsPerSecond then
        stats.dropped = stats.dropped + 1
        stats.rateLimited = stats.rateLimited + 1
        droppedSinceFlush = droppedSinceFlush + 1
        return false
    end

    rateWindowCount = rateWindowCount + 1
    return true
end

local function targetMetadata(player)
    local result = { userId = player.UserId }
    if CONFIG.IncludePlayerName then
        result.name = safeToString(player.Name)
        result.displayName = safeToString(player.DisplayName)
    end
    return result
end

local function captureRemoteRequest(remote, player, method, packedArgs)
    if not isTargetPlayer(player) or not allowRecord() then
        return nil
    end

    local remoteInfo = makeRemoteInfo(remote, player)
    local requestId = HttpService:GenerateGUID(false)

    local record = {
        recordType = "remote_request_received",
        requestId = requestId,
        method = method,
        player = targetMetadata(player),
        remote = remoteInfo,
        args = serializePackedArguments(packedArgs),
        note = "observed on server after delivery; this does not prove the game accepted the action",
    }

    emit(record)
    return requestId
end

-- ============================== REMOTE EVENT OBSERVERS =============
local installedEvents = setmetatable({}, { __mode = "k" })
local watchedRoots = setmetatable({}, { __mode = "k" })
local functionCandidates = setmetatable({}, { __mode = "k" })
local functionWrappers = setmetatable({}, { __mode = "k" })
local inventorySeen = setmetatable({}, { __mode = "k" })
local inventoryPending = {}
local sessionReady = false

local function registerRemoteInventory(remote)
    if inventorySeen[remote] then
        return
    end
    inventorySeen[remote] = true

    local className = getRemoteClass(remote)
    local record = {
        recordType = "remote_inventory",
        remote = makeRemoteInfo(remote, nil),
        serverHandlerState = className == "RemoteFunction"
            and (type(safeRead(remote, "OnServerInvoke")) == "function" and "present" or "not-assigned")
            or "not-inspectable-via-public-event-api",
        note = "Inventory is based on replicated containers; Workspace availability may depend on streaming.",
    }

    if sessionReady then
        emit(record)
    else
        inventoryPending[#inventoryPending + 1] = record
    end
end

local function isSupportedRemote(instance)
    local className = getRemoteClass(instance)
    return className == "RemoteEvent"
        or className == "UnreliableRemoteEvent"
        or className == "RemoteFunction"
end

local function installRemoteEvent(remote)
    if installedEvents[remote] or not CONFIG.CaptureRemoteEvents then
        return
    end

    local className = getRemoteClass(remote)
    if className == "UnreliableRemoteEvent" and not CONFIG.CaptureUnreliableRemoteEvents then
        return
    end
    if className ~= "RemoteEvent" and className ~= "UnreliableRemoteEvent" then
        return
    end

    local ok, connection = pcall(function()
        return remote.OnServerEvent:Connect(function(player, ...)
            if not isTargetPlayer(player) then
                return
            end

            stats.eventsSeen = stats.eventsSeen + 1
            local packedArgs = table.pack(...)
            captureRemoteRequest(remote, player, className .. ".OnServerEvent", packedArgs)
        end)
    end)

    if ok and connection then
        installedEvents[remote] = connection
    end
end

-- ============================== REMOTE FUNCTION WRAPPER ============
local function installRemoteFunction(remote)
    if not CONFIG.CaptureRemoteFunctions then
        return
    end

    local ok, currentCallback = pcall(function()
        return remote.OnServerInvoke
    end)
    if not ok or type(currentCallback) ~= "function" then
        return
    end

    local existing = functionWrappers[remote]
    if existing and existing.wrapper == currentCallback then
        return
    end

    local originalCallback = currentCallback
    local wrapper

    wrapper = function(player, ...)
        local packedArgs = table.pack(...)
        local requestId

        if isTargetPlayer(player) then
            stats.functionsSeen = stats.functionsSeen + 1
            requestId = captureRemoteRequest(
                remote,
                player,
                "RemoteFunction.InvokeServer",
                packedArgs
            )
        end

        -- pcall preserves multiple returns when paired with table.pack.
        -- It also changes the observable error stack; see warning above.
        local results = table.pack(pcall(
            originalCallback,
            player,
            table.unpack(packedArgs, 1, packedArgs.n)
        ))

        if requestId and isTargetPlayer(player) and allowRecord() then
            if results[1] then
                local returned = table.pack(table.unpack(results, 2, results.n))
                emit({
                    recordType = "remote_function_response",
                    requestId = requestId,
                    method = "RemoteFunction.OnServerInvoke:return",
                    player = targetMetadata(player),
                    remote = makeRemoteInfo(remote, player),
                    returns = serializePackedArguments(returned),
                })
            else
                emit({
                    recordType = "remote_function_error",
                    requestId = requestId,
                    method = "RemoteFunction.OnServerInvoke:error",
                    player = targetMetadata(player),
                    remote = makeRemoteInfo(remote, player),
                    error = serializeValue(results[2], 0, {}, { remaining = CONFIG.MaxNodesPerEvent }),
                })
            end
        end

        if not results[1] then
            error(results[2], 0)
        end
        return table.unpack(results, 2, results.n)
    end

    local setOk = pcall(function()
        remote.OnServerInvoke = wrapper
    end)

    if setOk then
        functionWrappers[remote] = {
            wrapper = wrapper,
            original = originalCallback,
        }
    end
end

-- ============================== DISCOVERY / WATCHERS ================
local function tryInstall(instance)
    if not isSupportedRemote(instance) then
        return
    end

    registerRemoteInventory(instance)
    local className = getRemoteClass(instance)
    if className == "RemoteEvent" or className == "UnreliableRemoteEvent" then
        installRemoteEvent(instance)
    elseif className == "RemoteFunction" then
        functionCandidates[instance] = true
        installRemoteFunction(instance)
    end
end

local function watchTree(root)
    if not root or watchedRoots[root] then
        return
    end
    watchedRoots[root] = true

    local ok, descendants = pcall(function()
        return root:GetDescendants()
    end)
    if ok then
        for _, descendant in ipairs(descendants) do
            tryInstall(descendant)
        end
    end

    pcall(function()
        root.DescendantAdded:Connect(tryInstall)
    end)
    tryInstall(root)
end

if CONFIG.WatchReplicatedStorage then
    watchTree(ReplicatedStorage)
end
if CONFIG.WatchReplicatedFirst then
    watchTree(ReplicatedFirst)
end
if CONFIG.WatchWorkspace then
    watchTree(Workspace)
end

local function watchPlayerContainers(player)
    if not isTargetPlayer(player) then
        return
    end

    local function inspectChild(child)
        if child.Name == "PlayerGui" or child.Name == "Backpack" then
            watchTree(child)
        end
    end

    for _, child in ipairs(player:GetChildren()) do
        inspectChild(child)
    end
    player.ChildAdded:Connect(inspectChild)

    player.CharacterAdded:Connect(function(character)
        watchTree(character)
    end)
    if player.Character then
        watchTree(player.Character)
    end
end

Players.PlayerAdded:Connect(watchPlayerContainers)
for _, player in ipairs(Players:GetPlayers()) do
    watchPlayerContainers(player)
end

-- RemoteFunction callbacks are rechecked because game scripts may assign
-- OnServerInvoke after this audit script starts.
if CONFIG.CaptureRemoteFunctions then
    task.spawn(function()
        while true do
            task.wait(CONFIG.RemoteFunctionRescanSeconds)
            for remote in pairs(functionCandidates) do
                if remote and remote.Parent then
                    installRemoteFunction(remote)
                end
            end
        end
    end)
end

-- ============================== OWNER VERDICT MARKER =================
-- Server-only BindableEvent. Existing handlers can optionally call:
-- ServerStorage.__PRO_ANALYSIS_MARK:Fire(player, category, action,
--     verdict, detailsTable)
-- Example verdicts: ACCEPTED, REJECTED, DETECTED, RATE_LIMITED.
local markEvent = ServerStorage:FindFirstChild("__PRO_ANALYSIS_MARK")
if markEvent and not markEvent:IsA("BindableEvent") then
    warn("[PRO-ANALYSIS] __PRO_ANALYSIS_MARK existe pero no es BindableEvent.")
else
    if not markEvent then
        markEvent = Instance.new("BindableEvent")
        markEvent.Name = "__PRO_ANALYSIS_MARK"
        markEvent.Parent = ServerStorage
    end

    markEvent.Event:Connect(function(player, category, action, verdict, details)
        if not isTargetPlayer(player) or not allowRecord() then
            return
        end

        stats.marksSeen = stats.marksSeen + 1
        emit({
            recordType = "server_verdict",
            player = targetMetadata(player),
            category = safeToString(category or "unspecified"),
            action = safeToString(action or "unspecified"),
            verdict = safeToString(verdict or "UNSPECIFIED"),
            details = serializeValue(details or {}, 0, {}, { remaining = CONFIG.MaxNodesPerEvent }),
        })
    end)
end

-- ============================== SESSION / SUMMARY ==================
local metadata = {
    recordType = "session_start",
    schema = "pro-analysis-blackbox-v2.1",
    auditId = CONFIG.AuditId,
    sessionId = sessionId,
    startedAtUtc = startedAtUtc,
    placeId = game.PlaceId,
    universeId = game.GameId,
    placeVersion = game.PlaceVersion,
    jobId = game.JobId,
    targetUserIds = (function()
        local ids = {}
        for userId, enabled in pairs(CONFIG.TargetUserIds) do
            if type(userId) == "number" and enabled == true then
                ids[#ids + 1] = userId
            end
        end
        table.sort(ids)
        return ids
    end)(),
    capture = {
        remoteEvents = CONFIG.CaptureRemoteEvents,
        unreliableRemoteEvents = CONFIG.CaptureUnreliableRemoteEvents,
        remoteFunctions = CONFIG.CaptureRemoteFunctions,
    },
    notes = {
        "Only server-received requests from configured UserIds are captured.",
        "RemoteEvent observer connections can mask no-listener discarded warnings.",
        "RemoteFunction wrapping is disabled by default and is behavior-affecting.",
        "No client privileges are granted by this script.",
    },
}

emit(metadata)
sessionReady = true
for _, inventoryRecord in ipairs(inventoryPending) do
    emit(inventoryRecord)
end
table.clear(inventoryPending)

Players.PlayerRemoving:Connect(function(player)
    if isTargetPlayer(player) then
        emit({
            recordType = "target_player_left",
            player = targetMetadata(player),
        })
    end
end)

task.spawn(function()
    while stateMarker.Parent do
        task.wait(CONFIG.FlushInterval)
        flushQueue()
    end
end)

game:BindToClose(function()
    local summary = {
        recordType = "session_summary",
        auditId = CONFIG.AuditId,
        sessionId = sessionId,
        stats = {
            eventsSeen = stats.eventsSeen,
            functionsSeen = stats.functionsSeen,
            marksSeen = stats.marksSeen,
            dropped = stats.dropped,
            rateLimited = stats.rateLimited,
            queueOverflow = stats.queueOverflow,
            serializationErrors = stats.serializationErrors,
        },
        queueRemaining = queueCount,
        endedAtUtc = DateTime.now():ToIsoDate(),
    }
    emit(summary)
    for _ = 1, 120 do
        if queueCount == 0 then break end
        flushQueue()
        task.wait(0.05)
    end
end)

