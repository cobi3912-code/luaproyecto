--[[
    Deep Client Console Capture
    ----------------------------
    Ejecuta este script una sola vez en Delta.
    Lee TODO el historial que Roblox expone mediante LogService:GetLogHistory()
    y lo guarda automáticamente en un único archivo .txt.

    No genera FireServer/InvokeServer ni modifica el estado del juego.
    Requiere que el executor exponga writefile; makefolder/isfolder son opcionales.
]]

local LogService = game:GetService("LogService")
local Players = game:GetService("Players")

local function safeToString(value)
    if value == nil then
        return "nil"
    end

    local ok, result = pcall(tostring, value)
    if ok then
        return result
    end

    return "<unprintable>"
end

local function sanitizeFilePart(value)
    local text = safeToString(value)
    text = text:gsub("[^%w%-%._]", "_")
    text = text:gsub("_+", "_")
    return text
end

local function nowTag()
    local ok, result = pcall(function()
        return os.date("%Y%m%d_%H%M%S")
    end)

    return (ok and result) or safeToString(os.time())
end

local function findExecutorFunction(name)
    local ok, direct = pcall(function()
        return _G[name]
    end)
    if ok and type(direct) == "function" then
        return direct
    end

    local envOk, env = pcall(function()
        return type(getgenv) == "function" and getgenv() or nil
    end)

    if envOk and type(env) == "table" and type(env[name]) == "function" then
        return env[name]
    end

    local directOk, globalValue = pcall(function()
        return _ENV and _ENV[name] or nil
    end)

    if directOk and type(globalValue) == "function" then
        return globalValue
    end

    return nil
end

local writeFile = findExecutorFunction("writefile")
local makeFolder = findExecutorFunction("makefolder")
local isFolder = findExecutorFunction("isfolder")

if not writeFile then
    warn("[Console Capture] writefile no está disponible en este executor.")
    return
end

local FOLDER = "DeepClientConsoleCaptures"
local folderReady = false

if isFolder and makeFolder then
    local existsOk, exists = pcall(function()
        return isFolder(FOLDER)
    end)

    if existsOk and exists then
        folderReady = true
    else
        local makeOk = pcall(function()
            makeFolder(FOLDER)
        end)
        folderReady = makeOk
    end
elseif makeFolder then
    pcall(function()
        makeFolder(FOLDER)
    end)
    folderReady = true
end

local function normalizeMessageType(value)
    return safeToString(value):gsub("^Enum%.MessageType%.", "")
end

local function normalizeTimestamp(value)
    if value == nil then
        return "nil"
    end

    if type(value) == "number" then
        return string.format("%.6f", value)
    end

    return safeToString(value)
end

local function isErrorType(messageType)
    return normalizeMessageType(messageType):lower():find("error", 1, true) ~= nil
end

local function isWarningType(messageType)
    local lowered = normalizeMessageType(messageType):lower()
    return lowered:find("warning", 1, true) ~= nil
        or lowered:find("warn", 1, true) ~= nil
end

local function renderEntry(index, entry)
    return string.format(
        "\n[%06d]\nType: %s\nTimestamp: %s\nMessage:\n%s\n",
        index,
        normalizeMessageType(entry.messageType),
        normalizeTimestamp(entry.timestamp),
        safeToString(entry.message)
    )
end

local function captureConsole()
    local ok, history = pcall(function()
        return LogService:GetLogHistory()
    end)

    if not ok then
        error("LogService:GetLogHistory() falló: " .. safeToString(history))
    end

    if type(history) ~= "table" then
        error("GetLogHistory() no devolvió una tabla.")
    end

    local total = 0
    local errors = 0
    local warnings = 0
    local chunks = table.create(#history + 24)

    chunks[#chunks + 1] = "============================================================"
    chunks[#chunks + 1] = "DEEP CLIENT CONSOLE CAPTURE"
    chunks[#chunks + 1] = "============================================================"
    chunks[#chunks + 1] = ""
    chunks[#chunks + 1] = "CaptureTime: " .. safeToString(os.date("%Y-%m-%d %H:%M:%S"))
    chunks[#chunks + 1] = "PlaceId: " .. safeToString(game.PlaceId)
    chunks[#chunks + 1] = "JobId: " .. safeToString(game.JobId)
    chunks[#chunks + 1] = "Player: " .. safeToString(Players.LocalPlayer and Players.LocalPlayer.Name)
    chunks[#chunks + 1] = "PlayerUserId: " .. safeToString(Players.LocalPlayer and Players.LocalPlayer.UserId)
    chunks[#chunks + 1] = "ReadSource: LogService:GetLogHistory()"
    chunks[#chunks + 1] = ""
    chunks[#chunks + 1] = "============================================================"
    chunks[#chunks + 1] = "SUMMARY"
    chunks[#chunks + 1] = "============================================================"

    local totalIndex = #chunks + 1
    chunks[#chunks + 1] = "TotalEntries: 0"

    local errorIndex = #chunks + 1
    chunks[#chunks + 1] = "Errors: 0"

    local warningIndex = #chunks + 1
    chunks[#chunks + 1] = "Warnings: 0"

    chunks[#chunks + 1] = ""
    chunks[#chunks + 1] = "============================================================"
    chunks[#chunks + 1] = "FULL CONSOLE HISTORY"
    chunks[#chunks + 1] = "============================================================"

    for index, entry in ipairs(history) do
        total += 1

        if isErrorType(entry.messageType) then
            errors += 1
        end

        if isWarningType(entry.messageType) then
            warnings += 1
        end

        chunks[#chunks + 1] = renderEntry(index, entry)
    end

    chunks[totalIndex] = "TotalEntries: " .. safeToString(total)
    chunks[errorIndex] = "Errors: " .. safeToString(errors)
    chunks[warningIndex] = "Warnings: " .. safeToString(warnings)

    return table.concat(chunks, "\n"), total, errors, warnings
end

local captureOk, reportText, total, errors, warnings = pcall(captureConsole)

if not captureOk then
    warn("[Console Capture] No se pudo leer la consola: " .. safeToString(reportText))
    return
end

local player = Players.LocalPlayer
local playerPart = player and sanitizeFilePart(player.Name) or "UnknownPlayer"
local placePart = sanitizeFilePart(game.PlaceId)
local fileName = string.format(
    "ConsoleCapture_%s_%s_%s.txt",
    placePart,
    playerPart,
    nowTag()
)

local outputPath = folderReady and (FOLDER .. "/" .. fileName) or fileName

local writeOk, writeErr = pcall(function()
    writeFile(outputPath, reportText)
end)

if not writeOk then
    warn("[Console Capture] No se pudo guardar el archivo: " .. safeToString(writeErr))
    return
end

print(string.format(
    "[Console Capture] Guardado OK | %d entradas | %d errores | %d warnings",
    total,
    errors,
    warnings
))
print("[Console Capture] Archivo: " .. outputPath)
